    {
      "parameters": {
        "jsCode": "const entrada = $input.all();\n\nconst contactos = entrada\n  .map(item => item.json)\n  .filter(contacto => contacto.id != null && String(contacto.id).trim() !== \"\");\n\nconst cantidad = contactos.length;\n\nlet estado = \"SIN_COINCIDENCIAS\";\n\nif (cantidad === 1) {\n  estado = \"UNICO\";\n} else if (cantidad > 1) {\n  estado = \"MULTIPLES\";\n}\n\nreturn [{\n  json: {\n    cantidad_contactos: cantidad,\n    estado_busqueda: estado,\n    contactos: contactos.map(contacto => ({\n      id: String(contacto.id),\n      email: contacto.properties?.email ?? \"\",\n      nombre: contacto.properties?.firstname ?? \"\",\n      apellido: contacto.properties?.lastname ?? \"\"\n    }))\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
