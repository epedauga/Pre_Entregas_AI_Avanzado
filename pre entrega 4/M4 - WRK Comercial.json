                "singleValue": true
              }
            },
            {
              "id": "19fc1a43-3295-446d-b338-be0bd9975dfa",
              "leftValue": "={{ ($json.estado_busqueda === 'UNICO' && $json.cantidad_contactos === 1 && Array.isArray($json.contactos) && $json.contactos.length === 1) || ($json.estado_busqueda === 'SIN_COINCIDENCIAS' && $json.cantidad_contactos === 0 && Array.isArray($json.contactos) && $json.contactos.length === 0) }}",
